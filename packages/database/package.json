{
  "name": "@repo/database",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "scripts": {
    "build": "pnpm run db:generate && tsc",
    "check-types": "pnpm run db:generate && tsc --noEmit",
    "db:generate": "prisma generate --generator client",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed:eval": "tsx prisma/seed-eval.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@prisma/studio-core": "0.21.1",
    "@repo/eslint-config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
